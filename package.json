{
  "name": "sprout-practice-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A privacy-friendly, static practice studio for children.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test-isolation=none --test",
    "test:coverage": "node --experimental-test-coverage --test-isolation=none --test --test-coverage-include=\"src/domain/*.js\"",
    "lint": "eslint src tests vite.config.js eslint.config.js --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.1"
  }
}
